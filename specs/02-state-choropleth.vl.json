{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Public hospital separations per 1,000 residents",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "width": "container",
  "height": 340,
  "projection": { "type": "mercator" },
  "data": {
    "url": "data/australian-states.geojson",
    "format": { "type": "json", "property": "features" }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": { "url": "data/state-pressure.csv", "format": { "type": "csv" } },
        "key": "State",
        "fields": ["Admissions", "Population", "RatePer1000"]
      }
    }
  ],
  "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2 },
  "encoding": {
    "color": {
      "field": "RatePer1000",
      "type": "quantitative",
      "title": "Separations per 1,000",
      "scale": { "scheme": "tealblues", "domain": [200, 700] },
      "legend": { "orient": "bottom", "format": ".0f" }
    },
    "tooltip": [
      { "field": "properties.STATE_NAME", "title": "State or territory" },
      { "field": "Admissions", "title": "Public separations", "format": "," },
      { "field": "Population", "title": "Population (June 2025)", "format": "," },
      { "field": "RatePer1000", "title": "Separations per 1,000", "format": ".1f" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "legend": {
      "labelColor": "#6b7b80",
      "titleColor": "#21333a",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
