{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Hospital beds per 1,000 people by country",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "width": "container",
  "height": 430,
  "projection": { "type": "equalEarth" },
  "data": { "values": [] },
  "layer": [
    {
      "mark": { "type": "geoshape", "stroke": "#939b98", "strokeWidth": 0.3},
      "encoding": {
        "color": { "value": "#e4e9e6" },
        "tooltip": [
          { "field": "properties.ADMIN", "title": "Country" },
          { "field": "HospitalBedsTooltip", "title": "Hospital beds per 1,000 people" },
          { "field": "SourceYearTooltip", "title": "Source data year" }
        ]
      }
    },
    {
      "transform": [{ "filter": "isValid(datum.HospitalBedsPer1000)" }],
      "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5 },
      "encoding": {
        "color": {
          "field": "HospitalBedsPer1000",
          "type": "quantitative",
          "title": "Hospital beds per 1,000 people",
          "scale": { "scheme": "tealblues", "domain": [0, 13], "clamp": true },
          "legend": { "orient": "bottom", "format": ".0f" }
        },
        "tooltip": [
          { "field": "properties.ADMIN", "title": "Country" },
          { "field": "HospitalBedsTooltip", "title": "Hospital beds per 1,000 people" },
          { "field": "SourceYearTooltip", "title": "Source data year" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "legend": {
      "labelColor": "#6b7b80",
      "titleColor": "#21333a",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
