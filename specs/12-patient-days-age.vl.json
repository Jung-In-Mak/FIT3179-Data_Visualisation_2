{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Patient days by age group, 2024–25",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "data": {
    "url": "data/patient-days-age-2024-25.csv",
    "format": { "type": "csv" }
  },
  "width": "container",
  "height": 330,
  "mark": { "type": "bar", "cornerRadiusEnd": 3 },
  "encoding": {
    "y": {
      "field": "AgeGroup",
      "type": "ordinal",
      "sort": { "field": "AgeOrder", "order": "ascending" },
      "title": "Age group (years)",
      "axis": { "labelColor": "#6b7b80", "titleColor": "#6b7b80" }
    },
    "x": {
      "field": "PatientDays",
      "type": "quantitative",
      "title": "Patient days",
      "axis": {
        "format": "~s",
        "gridColor": "#edf1ef"
      }
    },
    "color": {
      "value": "#14746f",
      "legend": null
    },
    "tooltip": [
      { "field": "AgeGroup", "title": "Age group (years)" },
      { "field": "PatientDays", "title": "Patient days", "format": "," }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "gridColor": "#edf1ef",
      "labelColor": "#6b7b80",
      "titleColor": "#6b7b80",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
