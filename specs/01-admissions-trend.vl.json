{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Hospital separations by sector",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "data": {
    "url": "data/hospital_admissions.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    { "filter": "datum.Sector !== 'All Hospitals'" }
  ],
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "sectorHighlight",
      "select": { "type": "point", "fields": ["Sector"] },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "point": { "filled": true, "size": 70 },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": { "labelAngle": 0 }
    },
    "y": {
      "field": "Admissions",
      "type": "quantitative",
      "title": "Separations",
      "axis": { "format": "~s" }
    },
    "color": {
      "field": "Sector",
      "type": "nominal",
      "title": "Hospital sector",
      "scale": {
        "domain": ["Public Hospitals", "Private Hospitals"],
        "range": ["#187b79", "#d77b45"]
      }
    },
    "opacity": {
      "condition": { "param": "sectorHighlight", "value": 1 },
      "value": 0.18
    },
    "tooltip": [
      { "field": "Year", "title": "Financial year" },
      { "field": "Sector", "title": "Sector" },
      { "field": "Admissions", "title": "Separations", "format": "," }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "gridColor": "#edf1ef",
      "labelColor": "#6b7b80",
      "titleColor": "#6b7b80",
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelColor": "#6b7b80",
      "titleColor": "#21333a",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
