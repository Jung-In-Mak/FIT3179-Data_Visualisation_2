{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Public hospital separations by state",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "data": { "values": [] },
  "width": "container",
  "height": 300,
  "projection": { "type": "mercator" },
  "layer": [
    {
      "data": { "values": [] },
      "mark": { "type": "geoshape", "fill": "#f3f6f4", "stroke": "#939b98", "strokeWidth": 1 },
      "encoding": {}
    },
    {
      "data": { "values": [] },
      "mark": {
        "type": "image",
        "url": "./data/hospital.png",
        "aspect": true,
        "align": "center",
        "baseline": "middle",
        "width": 1,
        "height": 1
      },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "tooltip": [
          { "field": "State", "title": "State or territory" },
          { "field": "Admissions", "title": "Public separations", "format": "," },
          { "field": "RatePer1000", "title": "Separations per 1,000", "format": ".1f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": null,
    "legend": {
      "labelColor": "#6b7b80",
      "titleColor": "#21333a",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
