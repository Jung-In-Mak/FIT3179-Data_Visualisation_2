{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Emergency and non-emergency admissions by month",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "data": {
    "url": "data/monthly-admission-urgency.csv",
    "format": { "type": "csv" }
  },
  "width": "container",
  "height": 225,
  "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 3, "cornerRadius": 5 },
  "encoding": {
    "x": {
      "field": "Month",
      "type": "ordinal",
      "sort": ["July", "August", "September", "October", "November", "December", "January", "February", "March", "April", "May", "June"],
      "title": null,
      "axis": { "labelAngle": 0 }
    },
    "y": {
      "field": "Urgency",
      "type": "ordinal",
      "sort": ["Emergency", "Non-emergency"],
      "title": null
    },
    "color": {
      "field": "Separations",
      "type": "quantitative",
      "title": "Separations",
      "scale": { "scheme": "orangered" },
      "legend": { "orient": "bottom", "format": "~s" }
    },
    "tooltip": [
      { "field": "Month", "title": "Month" },
      { "field": "Urgency", "title": "Admission urgency" },
      { "field": "Separations", "title": "Separations", "format": "," }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelColor": "#6b7b80",
      "titleColor": "#6b7b80",
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": { "labelFont": "Arial", "labelColor": "#6b7b80" }
  }
}
