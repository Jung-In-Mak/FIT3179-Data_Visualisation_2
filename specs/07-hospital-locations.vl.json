{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "877 hospital locations",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 15,
    "color": "#21333a"
  },
  "width": "container",
  "height": 350,
  "projection": { "type": "mercator" },
  "layer": [
    {
      "data": {
        "url": "data/australian-states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": { "type": "geoshape", "fill": "#e6eeea", "stroke": "#9fb2ac", "strokeWidth": 0.7 }
    },
    {
      "data": {
        "url": "data/health-facilities.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 25,
        "opacity": 0.62,
        "color": "#c2644c",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": { "field": "properties.longitude", "type": "quantitative" },
        "latitude": { "field": "properties.latitude", "type": "quantitative" },
        "tooltip": [
          { "field": "properties.organisation_name", "title": "Facility" },
          { "field": "properties.state", "title": "State" },
          { "field": "properties.nhsd_service_type", "title": "Listed service" }
        ]
      }
    }
  ],
  "config": { "view": { "stroke": null } }
}
