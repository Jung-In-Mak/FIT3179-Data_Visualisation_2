{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australian-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f3f6f4",
        "stroke": "#939b98",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/health-facilities.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 25,
        "opacity": 0.62,
        "color": "#14746f",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "properties.longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "properties.organisation_name",
            "title": "Facility"
          },
          {
            "field": "properties.state",
            "title": "State"
          },
          {
            "field": "properties.nhsd_service_type",
            "title": "Listed service"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Public Sans, Arial, sans-serif",
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15
    }
  }
}